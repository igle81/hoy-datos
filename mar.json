o":"Marejadilla","ola":"unos 1 m","mar_fondo":"unos 1 m","texto":"N o NW 2 o 3, rolando a E o NE por la noche, arreciando a E o SE 3 o 4 a medianoche, salvo 4 o 5 en la mitad sur durante la madrugada. Marejadilla o marejada, aumentando a marejada o fuerte marejada mar adentro. Mar de fondo W o NW en torno a 1 m en el extremo sur.","aviso":"No hay avisos.","elaborado":"2026-10-28T12:00:00","fin":"2026-10-29T12:00:00"},"8011112":{"nombre":"De Cabo Roche a Punta Camarinal (área Trafalgar)","estado":"Rizada","ola":"unos 1 m","mar_fondo":"unos 1 m","texto":"Variable 1 o 2 al principio, arreciando a E o NE 3 o 4, localmente 5 mar adentro al sur, y a 4 o 5 al norte de Trafalgar y a 5 o 6 al sur por la noche. Rizada o marejadilla, aumentando a marejada y localmente a fuerte marejada mar adentro. Mar de fondo W o NW en torno a 1 m, salvo de 1 a 2 m mar adentro.","aviso":"No hay avisos.","elaborado":"2026-10-28T12:00:00","fin":"2026-10-29T12:00:00"},"8011113":{"nombre":"De Punta Camarinal a Punta Carnero (área Tarifa)","estado":"Rizada","ola":"unos 1 m","mar_fondo":"unos 1 m","texto":"Variable 1 a 3 al principio, arreciando a E o NE 3 o 4 y 4 o 5 en la mitad este y a 5 o 6 en la mitad oeste por la noche. Rizada o marejadilla aumentando a marejada. Mar de fondo W o NW en torno a 1 m, salvo de 1 a 2 m mar adentro en el suroeste.","aviso":"No hay avisos.","elaborado":"2026-10-28T12:00:00","fin":"2026-10-29T12:00:00"},"8011114":{"nombre":"De Punta Carnero a Punta Chullera (área de Algeciras-Ceuta)","estado":"Rizada","ola":"0 a 0,1 m","mar_fondo":null,"texto":"Variable 1 o 2 al principio, arreciando a E o NE 2 o 3, a 3 o 4 por la noche, localmente 5 mar adentro de madrugada. Rizada o marejadilla, aumentando a marejada. Lluvias débiles al final en la costa de Punta Carnero.","aviso":"No hay avisos.","elaborado":"2026-10-28T12:00:00","fin":"2026-10-29T12:00:00"},"8011810":{"nombre":"Aguas costeras de Granada","estado":"Rizada","ola":"0 a 0,1 m","mar_fondo":null,"texto":"E 2 o 3 arreciando por la noche a 3 o 4. Rizada aumentando a marejadilla o marejada. Regular o mala desde la madrugada.","aviso":"No hay avisos","elaborado":"2026-10-28T12:00:00","fin":"2026-10-29T12:00:00"},"8012110":{"nombre":"Aguas costeras de Huelva","estado":"Rizada","ola":"0 a 0,1 m","mar_fondo":null,"texto":"Variable 1 a 3 al principio, tendiendo a W o NW 2 o 3, rolando a Componente E por la noche, tendiendo a E o NE 3 o 4 de madrugada y amainando a 2 o 3 al final. Rizada, aumentando a marejadilla mar adentro.","aviso":"No hay avisos.","elaborado":"2026-10-28T12:00:00","fin":"2026-10-29T12:00:00"},"8012910":{"nombre":"Aguas costeras de Málaga","estado":"Marejadilla","ola":"0,1 a 0,5 m","mar_fondo":null,"texto":"E o NE 3 o 4. Marejadilla, localmente marejada. Regular en el este al final.","aviso":"No hay avisos","elaborado":"2026-10-28T12:00:00","fin":"2026-10-29T12:00:00"},"8012920":{"nombre":"Aguas costeras de la isla de Alborán","estado":"Marejadilla","ola":"0,1 a 0,5 m","mar_fondo":null,"texto":"E o NE 2 o 3 arreciando por la noche a 3 o 4. Marejadilla o marejada.","aviso":"No hay avisos","elaborado":"2026-10-28T12:00:00","fin":"2026-10-29T12:00:00"},"8033010":{"nombre":"Aguas costeras de Asturias","estado":"Marejada","ola":"2 a 3 m","mar_fondo":"2 a 3 m","texto":"E o SE 5 o 6, amainando a 3 o 4 de madrugada y rolando desde el oeste a W o NW por la mañana. En costas, localmente Variable 1 o 2 desde la noche. Marejada o fuerte marejada, disminuyendo a rizada o marejadilla desde el oeste. Mar de fondo NW de 2 a 3 m, salvo de 3 a 4 m mar adentro al principio, disminuyendo en torno a 2 m por la noche. Lluvias al principio mar adentro en la mitad oeste. Localmente regular o mala.","aviso":"No hay avisos.","elaborado":"2026-10-28T12:00:00","fin":"2026-10-29T12:00:00"},"8040711":{"nombre":"Noroeste de Mallorca (de Dragonera a Formentor)","estado":"Marejada","ola":"1 m","mar_fondo":"1 m","texto":"NE 4 a 5 amainando a componente N 3. Marejada disminuyendo a marejadilla con mar de fondo del NE de 1 m. Algún aguacero por la mañana.","aviso":"No hay avisos","elaborado":"2026-10-28T12:00:00","fin":"2026-10-29T12:00:00"},"8040712":{"nombre":"Nordeste de Mallorca (de Formentor a Capdepera)","estado":"Fuerte marejada","ola":"1 m","mar_fondo":"1 m","texto":"N 5 a 6 amainando a 3. Fuerte marejada disminuyendo a marejadilla con mar de fondo del N de 1 m.","aviso":"No hay avisos","elaborado":"2026-10-28T12:00:00","fin":"2026-10-29T12:00:00"},"8040713":{"nombre":"Este de Mallorca (de Capdepera a Salinas)","estado":"Marejada","ola":"0,5 a 1,25 m","mar_fondo":null,"texto":"N y NE 5 a 6 amainando a 3. Marejada o fuerte marejada, disminuyendo a marejadilla.","aviso":"No hay avisos","elaborado":"2026-10-28T12:00:00","fin":"2026-10-29T12:00:00"},"8040714":{"nombre":"Sur de Mallorca (de Salinas a Dragonera)","estado":"Marejada","ola":"0,5 a 1,25 m","mar_fondo":null,"texto":"NE 4 a 5 amainando por la noche a 3 y rolando por la mañana a W. Marejada disminuyendo a marejadilla.","aviso":"No hay avisos","elaborado":"2026-10-28T12:00:00","fin":"2026-10-29T12:00:00"},"8040720":{"nombre":"Canal de Mallorca","estado":"Marejada","ola":"0,5 a 1,25 m","mar_fondo":null,"texto":"NE 4 a 5 amainando por la noche a 3 y rolando por la mañana a componente W. Marejada disminuyendo a marejadilla.","aviso":"No hay avisos","elaborado":"2026-10-28T12:00:00","fin":"2026-10-29T12:00:00"},"8040731":{"nombre":"Norte de Menorca","estado":"Fuerte marejada","ola":"1 m","mar_fondo":"1 m","texto":"N 5 a 6 amainando a 3 o 4. Fuerte marejada disminuyendo a marejada o marejadilla con mar de fondo del N de 1 m.","aviso":"No hay avisos","elaborado":"2026-10-28T12:00:00","fin":"2026-10-29T12:00:00"},"8040732":{"nombre":"Sur de Menorca","estado":"Marejada","ola":"1 m","mar_fondo":"1 m","texto":"N 4 a 5 amainando a 3. Marejada o fuerte marejada disminuyendo a marejadilla, con mar de fondo del N de 1 m en los extremos.","aviso":"No hay avisos","elaborado":"2026-10-28T12:00:00","fin":"2026-10-29T12:00:00"},"8040740":{"nombre":"Canal de Menorca","estado":"Fuerte marejada","ola":"1 m","mar_fondo":"1 m","texto":"N 5 a 6 amainando a componente N 3. Fuerte marejada disminuyendo a marejadilla con mar de fondo del N de 1 m.","aviso":"No hay avisos","elaborado":"2026-10-28T12:00:00","fin":"2026-10-29T12:00:00"},"8040760":{"nombre":"Aguas costeras de Cabrera","estado":"Marejada","ola":"0,5 a 1,25 m","mar_fondo":null,"texto":"NE 4 a 5 amainando por la noche a 3 y rolando por la mañana a W. Marejada disminuyendo a marejadilla.","aviso":"No hay avisos","elaborado":"2026-10-28T12:00:00","fin":"2026-10-29T12:00:00"},"8040770":{"nombre":"Aguas costeras de Ibiza","estado":"Marejada","ola":"1 m","mar_fondo":"1 m","texto":"NE 3 a 5 amainando a componente S 3. Marejada disminuyendo a marejadilla. Temporalmente en el norte y este, mar de fondo del NE de 1 m.","aviso":"No hay avisos","elaborado":"2026-10-28T12:00:00","fin":"2026-10-29T12:00:00"},"8040780":{"nombre":"Aguas costeras de Formentera","estado":"Marejada","ola":"0,5 a 1,25 m","mar_fondo":null,"texto":"NE 4 a 5 amainando a S y SE 3. Marejada disminuyendo a marejadilla.","aviso":"No hay avisos","elaborado":"2026-10-28T12:00:00","fin":"2026-10-29T12:00:00"},"8053550":{"nombre":"Aguas costeras de Gran Canaria","estado":"Rizada","ola":"unos 2 m","mar_fondo":"unos 2 m","texto":"Variable, principalmente N, 1 a 3. Rizada o marejadilla. Durante la noche en costas este y oeste, temporalmente N 4 y localmente marejada. Mar de fondo del NW en torno a 2 m.","aviso":"No hay avisos.","elaborado":"2026-10-28T12:00:00","fin":"2026-10-29T12:00:00"},"8053560":{"nombre":"Canal de Jandía-La Isleta","estado":"Rizada","ola":"1 a 2 m","mar_fondo":"1 a 2 m","texto":"Variable, principalmente N, 1 a 3. Rizada o marejadilla. Durante la noche, temporalmente N 4 y localmente marejada. Mar de fondo del NW de 1 a 2 m.","aviso":"No hay avisos.","elaborado":"2026-10-28T12:00:00","fin":"2026-10-29T12:00:00"},"8053570":{"nombre":"Aguas costeras de Lanzaro